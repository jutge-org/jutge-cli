{
    "name": "@jutge.org/cli",
    "description": "Jutge.org Command Line Interface",
    "version": "0.2.1",
    "homepage": "https://api.jutge.org/cli",
    "author": {
        "name": "Jutge.org",
        "url": "https://jutge.org"
    },
    "contributors": [
        {
            "name": "Jordi Petit",
            "url": "https://github.com/jordi-petit"
        },
        {
            "name": "Pau Fernández",
            "url": "https://github.com/pauek"
        }
    ],
    "keywords": [
        "jutge.org",
        "cli",
        "command line interface"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jutge-org/cli.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "module": "index.ts",
    "type": "module",
    "bin": {
        "jutge": "dist/index.js",
        "jutge-cli": "dist/index.js",
        "jutge-dev": "src/index.ts"
    },
    "files": [
        "README.md",
        "dist"
    ],
    "scripts": {
        "lint": "eslint .",
        "format": "bun prettier --write .",
        "depcheck": "bunx depcheck",
        "dev": "bun build --target bun --outfile dist/index.js ./src --watch",
        "build": "bun build --target bun --minify --outfile dist/index.js ./src"
    },
    "dependencies": {
        "@commander-js/extra-typings": "^14.0.0",
        "@inquirer/prompts": "^8.2.0",
        "@sinclair/typebox": "^0.34.38",
        "@sinclair/typebox-codegen": "^0.10.5",
        "@types/semver": "^7.7.1",
        "bun-types": "^1.3.5",
        "chalk": "^5.4.1",
        "cli-table3": "^0.6.5",
        "commander": "^14.0.2",
        "env-paths": "^3.0.0",
        "execa": "^9.6.1",
        "semver": "^7.7.3",
        "yaml": "^2.8.0",
        "zod": "^4.3.5",
        "zod-package-json": "^2.1.0",
        "zod-validation-error": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "eslint": "^9.39.2",
        "typescript-eslint": "^8.51.0",
        "prettier": "^3.7.4"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "prettier": {
        "semi": false,
        "singleQuote": true,
        "trailingComma": "all",
        "tabWidth": 4,
        "useTabs": false,
        "arrowParens": "always",
        "printWidth": 120
    }
}
