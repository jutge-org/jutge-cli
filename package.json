{
    "name": "@jutge.org/cli",
    "version": "0.1.5",
    "description": "Jutge.org CLI",
    "keywords": [
        "jutge.org",
        "cli",
        "command line interface"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jutge-org/cli.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://api.jutge.org/cli",
    "type": "module",
    "module": "index.ts",
    "bin": {
        "jutge": "./bin/jutge"
    },
    "files": [
        "bin",
        "package.json"
    ],
    "devDependencies": {
        "@types/bun": "latest",
        "@types/chalk": "^2.2.4"
    },
    "peerDependencies": {
        "typescript": "^5.6.2"
    },
    "dependencies": {
        "@commander-js/extra-typings": "^12.1.0",
        "@inquirer/prompts": "^7.4.0",
        "@sinclair/typebox": "^0.34.31",
        "@sinclair/typebox-codegen": "^0.10.5",
        "chalk": "^5.4.1",
        "cli-table3": "^0.6.5",
        "commander": "^12.1.0",
        "yaml": "^2.7.0",
        "zod": "^3.24.2"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --format esm --target node --banner '#!/usr/bin/env node' --outfile bin/jutge"
    },
    "prettier": {
        "trailingComma": "all",
        "semi": false,
        "singleQuote": false,
        "tabWidth": 4,
        "useTabs": false,
        "arrowParens": "always",
        "printWidth": 100
    }
}
