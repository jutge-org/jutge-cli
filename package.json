        "jutge": "./bin/jutge"
    },
    "files": [
        "bin",
        "package.json"
    ],
    "devDependencies": {
        "@types/bun": "latest",
        "@types/chalk": "^2.2.4"
    },
    "peerDependencies": {
        "typescript": "^5.6.2"
    },
    "dependencies": {
        "@commander-js/extra-typings": "^12.1.0",
        "@inquirer/prompts": "^7.3.3",
        "@sinclair/typebox": "^0.34.30",
        "@sinclair/typebox-codegen": "^0.10.5",
        "chalk": "^5.4.1",
        "cli-table3": "^0.6.5",
        "commander": "^12.1.0",
        "yaml": "^2.7.0",
        "zod": "^3.24.2"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --format esm --target node --banner '#!/usr/bin/env node' --outfile bin/jutge"
